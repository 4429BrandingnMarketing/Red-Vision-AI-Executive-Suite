{
  "name": "red-vision-ai-executive-suite",
  "private": true,
  "version": "0.1.0",
  "description": "Standalone Red Vision AI Executive Suite desktop application",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "check": "npm run typecheck && npm run build",
    "desktop": "npm run build && electron .",
    "desktop:dir": "npm run build && electron-builder --dir",
    "desktop:mac": "npm run build && electron-builder --mac dmg --x64 --publish never"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@radix-ui/react-slot": "^1.3.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "electron": "^39.8.10",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "build": {
    "appId": "com.redvision.executivesuite",
    "productName": "Red Vision AI Executive Suite",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": [{ "target": "dmg", "arch": ["x64"] }]
    },
    "dmg": {
      "title": "Red Vision AI Executive Suite"
    }
  }
}
